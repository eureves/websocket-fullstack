# Multi-stage build for Angular application - Following production best practices
# Stage 1: Build the Angular application
FROM node:20-alpine AS builder

WORKDIR /src

# Copy package files first for better caching
COPY frontend/package*.json ./

# Install dependencies
RUN npm ci

# Copy app source
COPY frontend/src ./src
COPY frontend/angular.json .
COPY frontend/tsconfig.app.json .
COPY frontend/tsconfig.json .
COPY frontend/tsconfig.spec.json .
COPY frontend/.editorconfig .
COPY frontend/README.md .
COPY frontend/public ./public

# Build the Angular app for production
RUN npm run build --prod

# Stage 2: Serve with nginx
FROM nginx:alpine

# Copy the built app from builder stage
COPY --from=builder /src/dist/frontend/browser /usr/share/nginx/html

# Copy custom nginx configuration
COPY nginx.conf /etc/nginx/nginx.conf

# Set proper permissions for nginx
RUN chown -R root:root /usr/share/nginx/html && \
    chmod -R 755 /usr/share/nginx/html

EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
